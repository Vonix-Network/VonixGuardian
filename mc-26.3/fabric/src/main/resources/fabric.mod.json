{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://github.com/Vonix-Network/VonixGuardian",
    "sources": "https://github.com/Vonix-Network/VonixGuardian",
    "issues": "https://github.com/Vonix-Network/VonixGuardian/issues"
  },
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "server": [
      "network.vonix.guardian.mc.v26_3.fabric.VonixGuardianFabric"
    ]
  },
  "mixins": [
    "vg.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25"
  },
  "custom": {
    "modmenu": {
      "badges": [
